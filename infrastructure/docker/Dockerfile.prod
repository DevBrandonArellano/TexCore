# --- Stage 1: Build wheel files ---
FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1 AS builder

# Define variables de entorno
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Instala las dependencias del sistema necesarias para compilar wheels
RUN apt-get update && \
    apt-get install -y curl apt-transport-https gnupg && \
    curl https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor > /usr/share/keyrings/microsoft-prod.gpg && \
    curl https://packages.microsoft.com/config/debian/12/prod.list > /etc/apt/sources.list.d/mssql-release.list && \
    apt-get update && \
    ACCEPT_EULA=Y apt-get install -y msodbcsql18 mssql-tools18 unixodbc-dev && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Copia los requisitos y compila los wheels
COPY requirements.txt .
RUN pip wheel --default-timeout=1000 --no-cache-dir --wheel-dir /app/wheels -r requirements.txt


# --- Stage 2: Final production image ---
FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1

# Define variables de entorno
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Instala las dependencias del sistema necesarias para ejecutar la aplicación
# Debe hacerse como root
RUN apt-get update && \
    apt-get install -y curl apt-transport-https gnupg && \
    curl https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor > /usr/share/keyrings/microsoft-prod.gpg && \
    curl https://packages.microsoft.com/config/debian/12/prod.list > /etc/apt/sources.list.d/mssql-release.list && \
    apt-get update && \
    ACCEPT_EULA=Y apt-get install -y msodbcsql18 unixodbc && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Crea un usuario sin privilegios de root y define el directorio de trabajo
RUN useradd --create-home appuser
WORKDIR /home/appuser/app

# Copia los wheels desde la etapa de compilación
# Debe hacerse como root para tener inicialmente los permisos correctos
COPY --from=builder /app/wheels /wheels

# Copia el código de la aplicación
COPY . .

# Asigna la propiedad de todos los archivos de la aplicación
RUN chown -R appuser:appuser /home/appuser/app /wheels

# Cambia al usuario sin privilegios de root
USER appuser

# Instala las dependencias desde los wheels
# La opción --user instala los paquetes en el directorio personal del usuario
RUN pip install --default-timeout=1000 --no-cache --user /wheels/*

# Añade el directorio bin local del usuario al PATH
ENV PATH="/home/appuser/.local/bin:${PATH}"

# Define STATIC_ROOT y recopila los archivos estáticos
ENV STATIC_ROOT=/home/appuser/app/staticfiles
# collectstatic no toca la base de datos ni firma JWT — estos son placeholders
# solo para satisfacer el fail-fast de settings.py (get_env_variable) al importar.
RUN SECRET_KEY=temporary_key_for_build \
    FIELD_ENCRYPTION_KEYS=Zm9yLWJ1aWxkLW9ubHktbm90LWEtcmVhbC1rZXktMDA= \
    BLIND_INDEX_KEY=build_placeholder \
    CORS_ALLOWED_ORIGINS=http://localhost \
    CSRF_TRUSTED_ORIGINS=http://localhost \
    DB_ENGINE=mssql \
    DB_NAME=build_placeholder \
    DB_USER=build_placeholder \
    DB_PASSWORD=build_placeholder \
    DB_HOST=build_placeholder \
    DB_PORT=1433 \
    DB_DRIVER="ODBC Driver 18 for SQL Server" \
    INTERNAL_JWT_PRIVATE_KEY=build_placeholder \
    INTERNAL_JWT_PUBLIC_KEY=build_placeholder \
    python manage.py collectstatic --no-input

# Expone el puerto en el que correrá Gunicorn
EXPOSE 8000

# Hace ejecutable el entrypoint
RUN chmod +x infrastructure/docker/entrypoint.sh infrastructure/docker/wait-for-it.sh

# Salud: GET /api/health/ con el Host de ALLOWED_HOSTS (ver healthcheck.py).
# start-period largo porque el entrypoint aplica las migraciones antes de
# arrancar gunicorn; con datos de años, una migración de datos puede tardar.
HEALTHCHECK --interval=30s --timeout=5s --start-period=600s --start-interval=5s --retries=3 \
    CMD ["python", "infrastructure/docker/healthcheck.py"]

# Define el entrypoint
ENTRYPOINT ["./infrastructure/docker/entrypoint.sh"]

# Run the application. Este CMD es solo el FALLBACK si alguien corre esta
# imagen sin docker-compose.prod.yml (que sobreescribe el número de workers
# con la variable BACKEND_WORKERS de .env). Para ajustar workers, cambiar
# BACKEND_WORKERS en .env — NO este archivo.
CMD ["gunicorn", "--workers", "3", "--bind", "0.0.0.0:8000", "--timeout", "120", "TexCore.wsgi:application"]
