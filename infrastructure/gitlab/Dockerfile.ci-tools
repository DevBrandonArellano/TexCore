# Imagen de herramientas de los jobs que construyen, firman y prueban imágenes
# (build, staging, deploy y rollback). Docker CLI + compose, bash, openssl, python con
# cryptography (staging_efimero.sh genera sus claves), jq, curl y cosign verificado.
# Se construye una vez en el equipo del runner: bash infrastructure/gitlab/construir_ci_tools.sh
FROM docker:27-cli@sha256:851f91d241214e7c6db86513b270d58776379aacc5eb9c4a87e5b47115e3065c

ARG COSIGN_VERSION=2.5.3
ARG COSIGN_SHA256=783b5d6c74105401c63946c68d9b2a4e1aab3c8abce043e06b8510b02b623ec9

RUN apk add --no-cache bash curl jq openssl git python3 py3-cryptography py3-requests \
    && curl -fsSL -o /usr/local/bin/cosign \
       "https://github.com/sigstore/cosign/releases/download/v${COSIGN_VERSION}/cosign-linux-amd64" \
    && echo "${COSIGN_SHA256}  /usr/local/bin/cosign" | sha256sum -c - \
    && chmod +x /usr/local/bin/cosign

ENTRYPOINT []
CMD ["bash"]
