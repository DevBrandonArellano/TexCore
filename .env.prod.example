# =============================================================================
# TEXCORE PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.prod)
# =============================================================================

# Django Monolith Configuration
DJANGO_SETTINGS_MODULE=TexCore.settings
SECRET_KEY=REPLACE_WITH_SECURE_64_CHAR_RANDOM_STRING
DEBUG=False
ALLOWED_HOSTS=texcore.tudominio.com,127.0.0.1,localhost,web

# SQL Server 2022 Database Configuration
DB_ENGINE=mssql
DB_NAME=texcore_db
DB_USER=sa
DB_PASSWORD=REPLACE_WITH_STRONG_SQL_SERVER_PASSWORD
DB_HOST=db
DB_PORT=1433

# Redis Cache & Task Queue
REDIS_URL=redis://redis:6379/0

# Internal JWT Authentication Secrets (Microservices Integration)
INTERNAL_JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
INTERNAL_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
X_INTERNAL_KEY=REPLACE_WITH_SECURE_API_SECRET_KEY

# Microservices Network Routing
PRINTING_SERVICE_URL=http://printing_service:8001
REPORTING_SERVICE_URL=http://reporting_excel:8002
SCANNING_SERVICE_URL=http://scanning_service:8000

# CORS & Security Configuration
CORS_ALLOWED_ORIGINS=https://texcore.tudominio.com

# Superusuario inicial (opcional) — consumido por `manage.py seed_production_masters`.
# Si se omite DJANGO_SUPERUSER_PASSWORD, el comando genera una contraseña
# aleatoria y la imprime una sola vez en su salida (anótala de inmediato).
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@texcore.local
# DJANGO_SUPERUSER_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
