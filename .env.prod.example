# =============================================================================
# TEXCORE — VARIABLES DE PRODUCCIÓN (.env.prod)
# Copia este archivo a .env.prod (permisos 600) y completa cada valor.
# Contiene exactamente las variables que usa infrastructure/docker/docker-compose.prod.yml;
# la prueba gestion/tests/test_despliegue_produccion.py lo verifica.
# Guía: docs/arquitectura/GUIA_DESPLIEGUE.md
# =============================================================================

# --- Imágenes -----------------------------------------------------------------
# Construcción local: un nombre propio y una etiqueta de versión. Con CI/CD, el
# registro (ghcr.io/<organización>/texcore) y la etiqueta que publica el pipeline.
CI_REGISTRY_IMAGE=texcore-local
TAG=v1.0.0

# --- Django -------------------------------------------------------------------
# 50+ caracteres aleatorios: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REEMPLAZAR_CON_UNA_CADENA_ALEATORIA_LARGA
# Cifrado de datos personales en reposo (RS-19 / LOPDP). Sin estas dos claves el
# backend no arranca, y si se pierden los datos cifrados no se recuperan: guárdalas
# en el gestor de secretos y en el respaldo cifrado, no solo en este archivo.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Lista separada por comas: la primera cifra, todas descifran (rotación sin parada).
FIELD_ENCRYPTION_KEYS=REEMPLAZAR_CON_UNA_CLAVE_FERNET
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Estable: si cambia, `manage.py cifrar_datos_personales --recalcular-indices`.
BLIND_INDEX_KEY=REEMPLAZAR_CON_UNA_CADENA_ALEATORIA
# Dominio o IP del servidor (el primero es el que usa el HEALTHCHECK del backend).
ALLOWED_HOSTS=texcore.tudominio.com,localhost
CSRF_TRUSTED_ORIGINS=https://texcore.tudominio.com
CORS_ALLOWED_ORIGINS=https://texcore.tudominio.com
# URL base del QR de cada lote: el mismo host que ALLOWED_HOSTS. Si la IP del
# servidor cambia, este es el único valor que hay que actualizar.
TRAZABILIDAD_BASE_URL=https://texcore.tudominio.com/trazabilidad

# --- SQL Server 2022 ----------------------------------------------------------
# Contraseña de la cuenta sa: 8+ caracteres con mayúsculas, minúsculas, números y símbolos.
DB_PASSWORD=REEMPLAZAR_CON_UNA_CONTRASENA_FUERTE
# Edición licenciada por la organización (Standard o Enterprise). Developer no está
# licenciada para producción; sin este valor el compose usa Developer.
MSSQL_PID=Standard

# --- Recursos por contenedor ----------------------------------------------------
# Medidos con 3 años de datos (docs/arquitectura/REQUISITOS_INFRAESTRUCTURA.md).
# Uso previsto: 50 personas conectadas, ~10 trabajando a la vez (validado con el doble, 20).
# Para 100 usuarios simultáneos: DB 3/3072, BACKEND 3/3072 y 20 workers; para 250, DB 6/6144.
DB_CPUS=2
DB_MEMORY_LIMIT_MB=2048
BACKEND_CPUS=1
BACKEND_MEMORY_LIMIT_MB=1024
BACKEND_WORKERS=4

# --- Autenticación entre servicios (JWT RS256) ----------------------------------
# Par de claves: python scripts/generate_rsa_keys.py. Una sola línea con \n.
INTERNAL_JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
INTERNAL_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Secretos con los que scanning_service y reporting_excel se registran ante el
# backend (32+ caracteres; uno distinto para cada servicio).
SCANNING_SERVICE_SECRET=REEMPLAZAR_CON_SECRETO_DE_SCANNING
REPORTING_SERVICE_SECRET=REEMPLAZAR_CON_SECRETO_DE_REPORTING

# Cola de exportes pesados (redis + celery_worker). Solo hexadecimal: va dentro de la URL
# del broker. Generar con: openssl rand -hex 24
REDIS_PASSWORD=REEMPLAZAR_CON_HEX_ALEATORIO
# Worker de exportes: 2 procesos para que dos exportes simultáneos no esperen en fila.
CELERY_CONCURRENCY=2
CELERY_CPUS=1
CELERY_MEMORY_LIMIT_MB=512
REDIS_MAXMEMORY_MB=64
REDIS_MEMORY_LIMIT_MB=128

# Cuenta inicial: scripts/deploy_production.sh ejecuta seed_production_masters, que
# crea los grupos RBAC y la cuenta `admin` con una contraseña aleatoria que imprime
# una sola vez en su salida. Anótala y cámbiala al primer ingreso.
