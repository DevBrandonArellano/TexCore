# =============================================================================
# Imagen para ejecutar la suite de pruebas backend de Django contra SQL Server.
# Incluye el driver ODBC 18 de Microsoft (necesario para pyodbc/mssql-django).
# Usada por scripts/run_backend_tests.sh.
# =============================================================================
FROM python:3.12-bookworm

# Driver ODBC para SQL Server + toolchain para compilar pyodbc
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        gnupg \
        apt-transport-https \
        unixodbc \
        unixodbc-dev \
    && curl -fsSL https://packages.microsoft.com/keys/microsoft.asc \
        | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/debian/12/prod bookworm main" \
        > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
