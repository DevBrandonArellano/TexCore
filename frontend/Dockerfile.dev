# Usa una imagen oficial de Node como imagen base
FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53

# Define el directorio de trabajo dentro del contenedor
WORKDIR /app

# Copia package.json y package-lock.json para aprovechar la caché de Docker
COPY package.json package-lock.json ./

# Instala las dependencias
RUN npm install

# Copia el resto del código de la aplicación
COPY . .

# Expone el puerto 5173 para el servidor de desarrollo
EXPOSE 5173

# Comando para iniciar el servidor de desarrollo
# npm install asegura deps en volumen nombrado; npx usa el binario local
CMD ["sh", "-c", "npm install && npx vite --host"]
