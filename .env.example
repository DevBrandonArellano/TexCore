# Environment variables for production

# Database Configuration
# It is strongly recommended to use a different, more secure password for production.
DB_PASSWORD=Password
DB_NAME=texcore_db
DB_USER=sa
DB_HOST=db
DB_PORT=1433
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENGINE=mssql

# Django Configuration
# Generate a new, random secret key for production.
# You can generate one with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=change-me-to-a-long-random-string-for-production

# Debug mode (0 for production, 1 for development)
DEBUG=0

# A comma-separated list of hostnames that your application can serve.
# For example: ALLOWED_HOSTS=texcore.com,www.texcore.com,192.168.1.100
# Use '*' to allow all hosts (less secure, but useful for initial testing).
ALLOWED_HOSTS=localhost,127.0.0.1,your-server-ip

# CORS Configuration - Comma-separated list of allowed origins
# IMPORTANT: Include the full URL with protocol (http:// or https://)
# Example: CORS_ALLOWED_ORIGINS=https://192.168.1.100,https://yourdomain.com,http://localhost:3000
CORS_ALLOWED_ORIGINS=https://localhost,https://127.0.0.1,http://localhost:3000

# Static Files
STATIC_ROOT=/home/appuser/app/staticfiles

# Reporting Excel Microservice (legado — reemplazado por JWT Service Tokens)
REPORTING_INTERNAL_KEY=change-me-to-a-long-random-string-for-production

# ──────────────────────────────────────────────────────────────
# Internal API — JWT Service Tokens RS256 (ISO 27001 A.10)
# Generar claves: python scripts/generate_rsa_keys.py
# IMPORTANTE: nunca commitear claves reales — usar Docker secrets en prod
# ──────────────────────────────────────────────────────────────
# Clave privada RSA 2048 (solo en Django/backend)
# Formato: contenido del PEM en una línea, \n literal como separador
INTERNAL_JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...(clave privada)...\n-----END RSA PRIVATE KEY-----"

# Clave pública RSA (distribuida a scanning_service y reporting_excel)
INTERNAL_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...(clave pública)...\n-----END PUBLIC KEY-----"

# Secrets de los microservicios (bcrypt-hasheados en ServiceCredential)
SCANNING_SERVICE_SECRET=scanning-dev-secret-change-in-prod
REPORTING_SERVICE_SECRET=reporting-dev-secret-change-in-prod
